    {
      "parameters": {
        "jsCode": "const answer = $json.answer || 'Не удалось получить ответ от RAG-сервиса.';\nconst sources = $json.sources || [];\n\nlet text = answer;\nconst links = sources.filter(s => s.link).map(s => ({ link: s.link }));\nif (links.length > 0) {\n  text += '\\n\\n📽 Источники:';\n  for (let i = 0; i < links.length; i++) {\n    text += `\\n${i + 1}. ${links[i].link}`;\n  }\n}\n\nreturn [{ json: { text, chatId: $('Telegram Trigger').first().json.message.chat.id } }];"
      },
