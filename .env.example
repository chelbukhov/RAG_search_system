# Скопируйте этот файл в .env на сервере (/opt/n8n/.env) и заполните.
# .env не попадает в git (добавлен в .gitignore).

# --- n8n ---------------------------------------------------------------
# Ключ шифрования n8n (защищает сохранённые учётные данные).
# НЕ менять после первого запуска, иначе сохранённые креды станут нечитаемыми.
N8N_ENCRYPTION_KEY=

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=bot_db
POSTGRES_USER=bot
POSTGRES_PASSWORD=
