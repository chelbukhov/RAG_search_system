# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не попадает в git (добавлен в .gitignore).

# --- Qdrant Cloud ------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=transcript_skin

# --- DeepSeek (LLM для ответов) через OpenRouter ------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat

# --- PostgreSQL (локальный каталог роликов) -----------------------------------
PG_HOST=postgres
PG_PORT=5432
PG_DB=bot_db
PG_USER=bot
PG_PASSWORD=
