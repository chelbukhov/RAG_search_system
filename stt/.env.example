# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не попадает в git (добавлен в .gitignore).

# --- Токен Telegram-бота (для скачивания голосового файла) ---------------------
TELEGRAM_BOT_TOKEN=

# --- Модель Whisper ------------------------------------------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Язык и скорость ------------------------------------------------------------
STT_LANGUAGE=ru
STT_BEAM_SIZE=1
